<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS .app bundle 清单（04 §5.3）。占位符由 build/package/package.py 填充。
  CFBundleDocumentTypes 只声明 Viewer + LSHandlerRank=Alternate：登记「可打开」
  但不抢系统默认程序（双击行为仍由用户选择，同 Windows 侧不篡夺默认动词的策略）。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>{{NAME}}</string>
    <key>CFBundleDisplayName</key>
    <string>{{NAME}}</string>
    <key>CFBundleIdentifier</key>
    <string>{{BUNDLE_ID}}</string>
    <key>CFBundleExecutable</key>
    <string>{{GUI_BIN}}</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- T-ICON：声明本地化集合是**功能前置**，不是装饰。`UTType.localizedDescription`
         （系统类型名 → 浏览页「类型」列）的语言由进程 bundle 的本地化集合决定，
         而不是由系统语言决定：同一台 zh_CN 机器上，未声明的 bundle 会拿到英文
         `"Zip archive"`，声明后才是 `"Zip归档"`。hzip 支持 zh-CN/en 两种界面语言
         （见 hzip-gui 的 rust-i18n 表），故在此如实声明；缺了它 macOS 侧的系统
         类型名会被 hzip-platform 的 `localization_matches_system` 门控挡掉
         （宁可不显示，也不中英混排）。 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>zh-Hans</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>zh-Hans</string>
        <string>en</string>
    </array>
    <key>CFBundleShortVersionString</key>
    <string>{{VERSION}}</string>
    <key>CFBundleVersion</key>
    <string>{{VERSION}}</string>
    <key>LSMinimumSystemVersion</key>
    <string>{{MIN_MACOS}}</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>{{COPYRIGHT}}</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Archive</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.archive</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
{{EXT_LIST}}
            </array>
        </dict>
    </array>
    <!-- Services（右键 ▸ 服务）。宿主**必须**自己声明，否则服务轨静默失效：
         NSRegisterServicesProvider(provider, "hzip") 注册的端口要能被系统找到，
         前提是 Info.plist 里有 NSPortName = hzip 的服务条目。
         NSPortName 必须逐字等于 hzip-gui 调用 NSRegisterServicesProvider 时用的端口名；
         NSMenuItem.default 必须与 crates/hzip-platform/src/context_menu/macos.rs 的
         `service_identifiers()` 逐字一致（设置页据此写 pbs 的 NSServicesStatus 启用项）。
         NSRequiredContext 把菜单项限制在 Finder 里（不污染其他应用的「服务」菜单）。
         声明**硬编码在此**（而非 metadata.toml）：驱动那个极简 TOML 解析器不支持
         数组-of-表，塞进去会直接 die。 -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Extract Here with hzip</string>
            </dict>
            <key>NSMessage</key>
            <string>extractHereWithHzip</string>
            <key>NSPortName</key>
            <string>hzip</string>
            <key>NSSendTypes</key>
            <array>
                <string>NSFilenamesPboardType</string>
                <string>public.file-url</string>
            </array>
            <key>NSRequiredContext</key>
            <dict>
                <key>NSApplicationIdentifier</key>
                <string>com.apple.finder</string>
            </dict>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Extract To with hzip</string>
            </dict>
            <key>NSMessage</key>
            <string>extractToWithHzip</string>
            <key>NSPortName</key>
            <string>hzip</string>
            <key>NSSendTypes</key>
            <array>
                <string>NSFilenamesPboardType</string>
                <string>public.file-url</string>
            </array>
            <key>NSRequiredContext</key>
            <dict>
                <key>NSApplicationIdentifier</key>
                <string>com.apple.finder</string>
            </dict>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Compress with hzip</string>
            </dict>
            <key>NSMessage</key>
            <string>compressWithHzip</string>
            <key>NSPortName</key>
            <string>hzip</string>
            <key>NSSendTypes</key>
            <array>
                <string>NSFilenamesPboardType</string>
                <string>public.file-url</string>
            </array>
            <key>NSRequiredContext</key>
            <dict>
                <key>NSApplicationIdentifier</key>
                <string>com.apple.finder</string>
            </dict>
        </dict>
    </array>
    <!-- URL scheme：hzip://（可选保留）。宿主侧暂不靠它派发动作（04 §5.3：`open <scheme>://`
         不可靠；动作走 App Group 文件队列），这里只做登记，避免 LaunchServices 把
         hzip:// 判给别的应用。 -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>{{BUNDLE_ID}}</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>hzip</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
